    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .galeria-item.grande { grid-row: span 1; }
  .lightbox-ant, .lightbox-prox { top: auto; bottom: calc(10px + env(safe-area-inset-bottom, 0px)); transform: none; }
  .mapa { aspect-ratio: 4 / 3; }
