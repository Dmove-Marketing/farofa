  .lista-eventos li:nth-child(even) { padding-left: 16px; }
  .icone-evento { width: 54px; height: 54px; }
  .icone-evento svg { width: 28px; height: 28px; }
  .lista-diferenciais { grid-template-columns: minmax(0, 1fr); gap: 44px; }
