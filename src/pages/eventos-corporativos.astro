        </div>
        <div class="localizacao-botoes">
          <a class="btn btn-brasa" href="https://www.google.com/maps/search/?api=1&query=R.%20Guaip%C3%A1%2C%20551%20-%20Vila%20Leopoldina%2C%20S%C3%A3o%20Paulo%20-%20SP%2C%2005089-001" target="_blank" rel="noopener">Abrir no Google Maps</a>
