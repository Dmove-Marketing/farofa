</Base>

<style is:global>
/* ── Fonte própria ─────────────────────────────────────────── */
@font-face {
  font-family: "TAN Harmoni";
  src: url("/fonts/tan-harmoni.woff2") format("woff2"),
       url("/fonts/tan-harmoni.ttf")   format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* ── Tokens do projeto (sobrepõe o global.css) ─────────────── */
:root {
  --cor-brasa:        #902601;
  --cor-brasa-escura: #6d1c00;
  --cor-caramelo:     #94491e;
  --cor-creme:        #f4eed2;
  --cor-creme-2:      #ebe2bf;
  --cor-preto:        #000000;
  --cor-texto-suave:  rgba(0, 0, 0, 0.72);
  --cor-creme-suave:  rgba(244, 238, 210, 0.78);
  --cor-linha:        rgba(0, 0, 0, 0.16);
  --cor-linha-clara:  rgba(244, 238, 210, 0.22);
  --cor-campo:        #fffcef;
  --fonte-titulo:    "TAN Harmoni", "Playfair Display", Georgia, serif;
  --fonte-texto:     "Quicksand", "Trebuchet MS", system-ui, sans-serif;
  --fonte-manuscrita:"Architects Daughter", "Comic Neue", "Segoe Print", cursive;

  --largura-max:    1240px;
  --gutter:         clamp(20px, 4vw, 48px);
  --espaco-secao:   clamp(72px, 9vw, 120px);
  --raio:           6px;

  /* alinha com o sistema de forms.ts */
  --color-primary: var(--cor-brasa);
}

/* ── Base ──────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--cor-creme);
  color: var(--cor-preto);
  font-family: var(--fonte-texto);
  font-weight: 500;
  font-size: 17px;
  line-height: 1.36;
  -webkit-font-smoothing: antialiased;
  overflow-x: clip;
}
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; }
button { font: inherit; cursor: pointer; }
:focus-visible { outline: 3px solid var(--cor-caramelo); outline-offset: 3px; }
.visualmente-oculto { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

.wrap { width: 100%; max-width: var(--largura-max); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
.secao { padding-block: var(--espaco-secao); }

/* ── Tipografia ────────────────────────────────────────────── */
h1, h2, h3 { font-family: var(--fonte-titulo); font-weight: 400; margin: 0; text-wrap: balance; }
.titulo-secao { font-size: clamp(36px, 4.6vw, 64px); line-height: 0.9; letter-spacing: 0.01em; text-transform: uppercase; }
.texto-secao  { margin: 0; max-width: 56ch; font-size: clamp(16px, 1.25vw, 18px); color: var(--cor-texto-suave); }

/* ── Botões ────────────────────────────────────────────────── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  border: 0; border-radius: var(--raio);
  padding: 16px 28px;
  font-family: var(--fonte-texto); font-weight: 700; font-size: 16px; line-height: 1.02;
  text-decoration: none; text-align: center;
  transition: background-color .2s ease, color .2s ease, transform .2s ease;
}
.btn:active { transform: translateY(1px); }
.btn-brasa    { background: var(--cor-brasa);        color: var(--cor-creme); }
.btn-brasa:hover  { background: var(--cor-brasa-escura); }
.btn-creme    { background: var(--cor-creme);        color: var(--cor-brasa); }
.btn-creme:hover  { background: #fff8dc; }
.btn-contorno { background: transparent; color: inherit; box-shadow: inset 0 0 0 1.5px currentColor; }
.btn-contorno:hover { background: rgba(0,0,0,.06); }
.btn svg { width: 20px; height: 20px; flex: none; }

/* ── Cabeçalho ─────────────────────────────────────────────── */
.cabecalho {
  position: fixed; top: 0; left: 0; right: 0; z-index: 50;
  padding-top: env(safe-area-inset-top, 0px);
  transition: background-color .3s ease, box-shadow .3s ease;
}
.cabecalho .wrap { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 84px; transition: height .3s ease; }
.cabecalho.solido { background: var(--cor-preto); box-shadow: 0 1px 0 var(--cor-linha-clara); }
.cabecalho.solido .wrap { height: 68px; }
.cabecalho .logo img { width: 132px; height: auto; transition: width .3s ease; }
.cabecalho.solido .logo img { width: 112px; }
.cabecalho-acoes { display: flex; align-items: center; gap: 22px; opacity: 0; pointer-events: none; transition: opacity .3s ease; }
.cabecalho-acoes.visivel { opacity: 1; pointer-events: auto; }
.cabecalho .btn { padding: 12px 20px; font-size: 15px; }

/* ── Hero / Primeira dobra ─────────────────────────────────── */
.primeira-dobra {
  position: relative; isolation: isolate;
  color: var(--cor-creme);
  padding-top: calc(130px + env(safe-area-inset-top, 0px));
  padding-bottom: clamp(56px, 7vw, 96px);
  overflow: hidden;
}
.hero, .form-topo { min-width: 0; }
.hero-fundo { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
.hero-fundo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
.hero-fundo::after {
  content: ""; position: absolute; inset: 0;
  background:
    linear-gradient(90deg, rgba(0,0,0,.86) 0%, rgba(0,0,0,.66) 46%, rgba(0,0,0,.30) 100%),
    linear-gradient(180deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 30%, rgba(0,0,0,.25) 100%);
}
.hero-grade { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
.hero-texto { min-width: 0; }
.local { margin: 0 0 22px; font-family: var(--fonte-texto); font-weight: 600; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.2; letter-spacing: .02em; }
.hero h1 { font-size: clamp(54px, 6.6vw, 98px); line-height: 0.88; letter-spacing: 0.01em; text-transform: uppercase; }
.hero-sub { margin: 26px 0 0; max-width: 34ch; font-size: clamp(17px, 1.45vw, 21px); line-height: 1.275; color: var(--cor-creme-suave); }

/* ── Formulário ────────────────────────────────────────────── */
.form-cartao {
  background: var(--cor-creme); color: var(--cor-preto);
  border-radius: 10px;
  padding: clamp(24px, 2.6vw, 36px);
  box-shadow: 0 30px 60px -20px rgba(0,0,0,.55);
  min-width: 0;
}
.form-titulo { font-family: var(--fonte-titulo); font-size: clamp(30px, 2.6vw, 38px); line-height: 0.85; margin: 0 0 20px; color: var(--cor-brasa); }
.form-orcamento .campos { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; align-items: end; }
.campo { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.campo-full { grid-column: 1 / -1; }
.campo label { font-size: 14px; font-weight: 700; line-height: 1.02; }
.campo-hint { font-weight: 400; opacity: .7; }
.campo input, .campo select, .campo textarea {
  width: 100%; min-width: 0;
  font-family: var(--fonte-texto); font-size: 16px; font-weight: 600; color: var(--cor-preto);
  background: var(--cor-campo);
  border: 1.5px solid rgba(0,0,0,.22); border-radius: var(--raio);
  padding: 13px 14px;
  transition: border-color .2s ease, box-shadow .2s ease;
}
.campo input::placeholder, .campo textarea::placeholder { color: rgba(0,0,0,.42); font-weight: 500; }
.campo input:focus, .campo select:focus, .campo textarea:focus {
  outline: none;
  border-color: var(--cor-brasa);
  box-shadow: 0 0 0 3px rgba(144,38,1,.18);
}
.campo textarea { resize: vertical; min-height: 80px; }

/* Select customizado */
.campo-select-wrap { position: relative; }
.campo-select-wrap select { padding-right: 36px; appearance: none; -webkit-appearance: none; cursor: pointer; }
.campo-select-seta { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; pointer-events: none; color: var(--cor-caramelo); }

.acao { grid-column: 1 / -1; }
.form-orcamento .btn { width: 100%; padding: 15px 20px; }
.aviso-privacidade { margin: 14px 0 0; font-size: 13px; line-height: 1.232; color: var(--cor-texto-suave); }

/* Estado de sucesso do formulário */
.form-success { display: none; padding: 24px 0; text-align: center; }
.form-success.active { display: block; }
.form-success-icon { width: 54px; height: 54px; margin: 0 auto 16px; border-radius: 50%; background: var(--cor-brasa); color: var(--cor-creme); display: grid; place-items: center; font-size: 22px; }
.form-success h3 { font-family: var(--fonte-titulo); font-size: 28px; color: var(--cor-brasa); margin: 0 0 8px; text-transform: uppercase; }
.form-success p { font-size: 15px; color: var(--cor-texto-suave); margin: 0; }

/* Erros de campo (forms.ts) */
.field-error { color: #c0392b; font-size: 0.78rem; margin-top: 4px; display: none; }
.field-error.visible { display: block; }

/* ── Autoridade ────────────────────────────────────────────── */
.autoridade { background: var(--cor-brasa); color: var(--cor-creme); }
.autoridade ul { list-style: none; margin: 0; padding: 0; display: flex; }
.autoridade li { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; gap: 16px; padding: 34px 28px; text-align: left; }
.autoridade .unidade { text-transform: none; }
.autoridade li:not(:last-child) strong { white-space: nowrap; }
.contador { display: inline-block; text-align: right; font-variant-numeric: tabular-nums; }
.autoridade.animar li { opacity: 0; transform: translateY(16px); }
.autoridade.animar svg { transform: scale(.4); opacity: 0; }
.autoridade.animado li { opacity: 1; transform: none; transition: opacity .7s ease, transform .7s cubic-bezier(.2, .7, .2, 1); }
.autoridade.animado svg { opacity: .9; transform: none; transition: opacity .5s ease, transform .6s cubic-bezier(.34, 1.56, .64, 1); }
.autoridade.animado li:nth-child(2), .autoridade.animado li:nth-child(2) svg { transition-delay: .18s; }
.autoridade.animado li:nth-child(3), .autoridade.animado li:nth-child(3) svg { transition-delay: .36s; }
.autoridade li + li { border-left: 1px solid var(--cor-linha-clara); }
.autoridade svg { width: 34px; height: 34px; flex: none; opacity: .9; }
.autoridade strong { font-family: var(--fonte-titulo); font-weight: 400; font-size: clamp(24px, 2.4vw, 34px); line-height: 0.892; text-transform: uppercase; letter-spacing: .01em; }

/* ── Experiência 360° ──────────────────────────────────────── */
.experiencia-grade { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
.experiencia-texto { min-width: 0; }
.experiencia-texto h2 span { display: block; white-space: nowrap; }
.experiencia-texto .texto-secao { margin-top: 26px; max-width: 46ch; }
.experiencia-foto { position: relative; min-width: 0; }
.experiencia-foto img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--raio); }
.selo-360 {
  --tamanho-selo: clamp(128px, 12vw, 168px);
  position: absolute; right: calc(var(--tamanho-selo) / -4); top: calc(var(--tamanho-selo) / -4);
  width: var(--tamanho-selo); aspect-ratio: 1;
  border-radius: 50%;
  background: var(--cor-brasa); color: var(--cor-creme);
  display: grid; place-items: center;
  box-shadow: 0 0 0 6px var(--cor-creme);
}
.selo-360 svg.anel { position: absolute; inset: 0; width: 100%; height: 100%; animation: girar 36s linear infinite; }
.selo-360 .numero { font-family: var(--fonte-titulo); font-size: clamp(34px, 3.2vw, 46px); line-height: 0.85; }
@keyframes girar { to { transform: rotate(360deg); } }

/* ── Eventos ───────────────────────────────────────────────── */
.eventos { background: var(--cor-creme-2); }
.eventos .titulo-secao { text-align: center; }
.eventos .titulo-secao span { display: block; }
.lista-eventos {
  list-style: none; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0;
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  border-top: 1.5px solid var(--cor-preto);
}
.lista-eventos li { display: flex; align-items: center; gap: 20px; padding: 30px 24px 30px 0; border-bottom: 1px solid var(--cor-linha); font-family: var(--fonte-texto); font-weight: 700; font-size: clamp(17px, 1.35vw, 20px); line-height: 1.2; }
.lista-eventos li:not(:nth-child(3n+1)) { padding-left: 24px; border-left: 1px solid var(--cor-linha); }
.icone-evento { width: 64px; height: 64px; flex: none; border-radius: 50%; background: var(--cor-brasa); color: var(--cor-creme); display: grid; place-items: center; }
.icone-evento svg { width: 32px; height: 32px; }

/* ── Diferenciais ──────────────────────────────────────────── */
.diferenciais { background: var(--cor-preto); color: var(--cor-creme); }
.diferenciais .titulo-secao { text-align: center; }
.diferenciais .titulo-secao span { display: block; }
.lista-diferenciais { list-style: none; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 2.5vw, 36px); }
.lista-diferenciais li { min-width: 0; text-align: center; }
.diferencial-foto { border-radius: var(--raio); overflow: hidden; }
.lista-diferenciais img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; transition: transform .7s cubic-bezier(.2, .7, .2, 1), filter .7s ease; }
@media (hover: hover) { .lista-diferenciais li:hover img { transform: scale(1.07); filter: brightness(1.08) saturate(1.08); } }
.lista-diferenciais h3 { margin: 24px 0 10px; font-size: clamp(28px, 2.4vw, 34px); line-height: 0.892; color: var(--cor-creme); }
.lista-diferenciais p { margin: 0 auto; font-size: 16px; color: var(--cor-creme-suave); max-width: 38ch; }

/* ── Gastronomia ───────────────────────────────────────────── */
.gastronomia { background: var(--cor-brasa); color: var(--cor-creme); overflow: hidden; }
.gastronomia-topo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 80px); align-items: end; }
.gastronomia .texto-secao { color: var(--cor-creme-suave); }
.trilho-wrap { margin-top: clamp(36px, 4.5vw, 56px); }
.trilho { overflow-x: auto; scrollbar-width: none; outline-offset: -3px; }
.trilho::-webkit-scrollbar { display: none; }
.trilho-faixa { display: flex; gap: 16px; width: max-content; padding-right: 16px; }
.trilho.infinito { overflow: hidden; }
.trilho.infinito .trilho-faixa { animation: deslizar var(--duracao-trilho, 70s) linear infinite; }
.trilho.infinito:hover .trilho-faixa,
.trilho.infinito:focus-within .trilho-faixa,
.trilho.infinito.pausado .trilho-faixa { animation-play-state: paused; }
@keyframes deslizar { to { transform: translateX(-50%); } }
.trilho figure { margin: 0; flex: 0 0 clamp(240px, 24vw, 320px); }
.trilho img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--raio); }

/* ── Clientes ──────────────────────────────────────────────── */
.clientes-grade { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
.clientes-texto { min-width: 0; grid-column: 2; grid-row: 1; }
.clientes .texto-secao { margin-top: 24px; }
.logos-carrossel { min-width: 0; grid-column: 1; grid-row: 1; }
.logos-slider { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; cursor: grab; user-select: none; -webkit-user-select: none; }
.logos-slider::-webkit-scrollbar { display: none; }
.logos-slider.arrastando { cursor: grabbing; scroll-snap-type: none; }
.logos { list-style: none; margin: 0; padding: 0; display: flex; }
.logos li { flex: 0 0 calc(100% / 2.3); display: grid; place-items: center; height: clamp(180px, 15vw, 220px); padding: 12px; scroll-snap-align: start; }
.logos img { width: auto; height: 104px; max-width: 100%; object-fit: contain; opacity: .85; pointer-events: none; -webkit-user-drag: none; }
.logos img.logo-natura    { height: 150px; }
.logos img.logo-nuvemshop { height: 132px; }
.logos img.logo-siemens   { height: 44px;  }
.logos img.logo-quata, .logos img.logo-swift { height: 96px; }
.logos-controles { display: flex; justify-content: center; gap: 10px; margin-top: 18px; }
.seta { width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid var(--cor-brasa); background: transparent; color: var(--cor-brasa); display: grid; place-items: center; transition: background-color .2s ease, color .2s ease; }
.seta:hover { background: var(--cor-brasa); color: var(--cor-creme); }
.seta svg { width: 20px; height: 20px; }

/* ── Galeria ───────────────────────────────────────────────── */
.galeria { background: var(--cor-preto); color: var(--cor-creme); }
.galeria .titulo-secao { text-align: center; }
.galeria-grade {
  --gap-mosaico: 14px;
  --linha-mosaico: calc((min(100vw, var(--largura-max)) - 2 * var(--gutter) - 3 * var(--gap-mosaico)) / 4);
  margin-top: clamp(40px, 5vw, 64px);
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
  grid-auto-rows: var(--linha-mosaico); grid-auto-flow: dense; gap: var(--gap-mosaico);
}
.galeria-item { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: #1a1a1a; border-radius: var(--raio); overflow: hidden; }
.galeria-item.grande { grid-column: span 2; grid-row: span 2; }
.galeria-item.alto   { grid-row: span 2; }
.galeria-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.galeria-item:hover img { transform: scale(1.04); }

.lightbox { border: 0; padding: 0; margin: 0; width: 100vw; height: 100vh; max-width: none; max-height: none; background: rgba(0,0,0,.94); color: var(--cor-creme); }
.lightbox[open] { display: grid; place-items: center; }
.lightbox::backdrop { background: rgba(0,0,0,.94); }
.lightbox img { max-width: min(92vw, 1400px); max-height: 84vh; width: auto; height: auto; border-radius: 4px; }
.lightbox-fechar, .lightbox-ant, .lightbox-prox { position: fixed; border: 0; background: rgba(244,238,210,.12); color: var(--cor-creme); width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; }
.lightbox-fechar { top: calc(16px + env(safe-area-inset-top, 0px)); right: 16px; }
.lightbox-ant { left: 16px; top: 50%; transform: translateY(-50%); }
.lightbox-prox { right: 16px; top: 50%; transform: translateY(-50%); }
.lightbox button:hover { background: rgba(244,238,210,.24); }
.lightbox svg { width: 24px; height: 24px; }
.lightbox-contador { pointer-events: none; position: fixed; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); left: 0; right: 0; text-align: center; font-size: 14px; color: var(--cor-creme-suave); margin: 0; }

/* ── Localização ───────────────────────────────────────────── */
.localizacao-grade { display: flex; flex-direction: column; align-items: center; text-align: center; }
.localizacao .titulo-secao { max-width: 24ch; }
.endereco { display: flex; gap: 12px; align-items: flex-start; justify-content: center; text-align: left; margin: 26px 0 0; font-style: normal; font-size: clamp(17px, 1.4vw, 20px); font-weight: 600; line-height: 1.275; }
.endereco svg { width: 26px; height: 26px; color: var(--cor-brasa); flex: none; margin-top: 2px; }
.mapa { margin-top: clamp(32px, 4vw, 48px); }
.localizacao-botoes { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
.mapa { min-width: 0; width: 100%; height: clamp(360px, 34vw, 480px); border-radius: var(--raio); overflow: hidden; background: var(--cor-creme-2); box-shadow: 0 0 0 1px var(--cor-linha), 0 24px 48px -24px rgba(0,0,0,.35); }
.mapa iframe { display: block; width: 100%; height: 100%; border: 0; }

/* ── Contato ───────────────────────────────────────────────── */
.contato { background: var(--cor-brasa); color: var(--cor-creme); }
.contato-grade { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
.contato-texto { min-width: 0; }
.contato .texto-secao { margin-top: 24px; color: var(--cor-creme-suave); }

/* ── Rodapé ────────────────────────────────────────────────── */
.rodape { background: var(--cor-preto); color: var(--cor-creme-suave); padding-block: 56px 40px; font-size: 14px; }
.rodape-grade { display: flex; justify-content: center; }
.rodape-logo img { width: 150px; height: auto; }
.rodape-base { margin-top: 36px; padding-top: 22px; border-top: 1px solid var(--cor-linha-clara); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13px; }

/* ── Barra mobile ───────────────────────────────────────────── */
.barra-mobile {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
  display: none; gap: 10px;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
  background: var(--cor-preto);
  box-shadow: 0 -8px 24px -8px rgba(0,0,0,.5);
  transform: translateY(110%); transition: transform .3s ease;
}
.barra-mobile.visivel { transform: translateY(0); }
.barra-mobile .btn { flex: 1; padding: 15px 16px; }
.barra-mobile .btn-brasa-full { text-align: center; }

/* ── Responsivo ────────────────────────────────────────────── */
@media (max-width: 1080px) {
  .hero-grade { grid-template-columns: minmax(0, 1fr); }
  .hero-texto { max-width: 680px; }
  .form-cartao { max-width: 680px; }
  .lista-eventos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lista-eventos li:not(:nth-child(3n+1)) { padding-left: 0; border-left: 0; }
  .lista-eventos li:nth-child(even) { padding-left: 24px; border-left: 1px solid var(--cor-linha); }
  .experiencia-grade, .clientes-grade, .contato-grade { grid-template-columns: minmax(0, 1fr); }
  .clientes-texto, .logos-carrossel { grid-column: auto; grid-row: auto; }
  .experiencia-foto img { aspect-ratio: 16 / 9; }
  .selo-360 { right: 16px; }
  .autoridade li { padding: 28px 16px; gap: 12px; }
  .autoridade svg { width: 28px; height: 28px; }
  .mapa { height: auto; aspect-ratio: 16 / 10; }
}

