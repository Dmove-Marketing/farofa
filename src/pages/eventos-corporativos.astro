            data-form-id="lead-form-contato"
            data-submit-url={webhook}
            data-grid-id="form-contato-campos"
            data-success-id="form-contato-success"
          >
            <input name="website" type="text" style="display:none" tabindex="-1" autocomplete="off" />
            <div class="campos" id="form-contato-campos">
              {fields.map((f) => (
                <div class:list={['campo', f.full ? 'campo-full' : '']}>
                  <label for={`form-field-c-${f.name}`}>
                    {f.label}{f.hint && <> <span class="campo-hint">({f.hint})</span></>}
                  </label>
                  {f.type === 'select' ? (
                    <div class="campo-select-wrap">
                      <select
                        id={`form-field-c-${f.name}`}
                        name={f.name}
                        required={f.required || undefined}
                      >
                        {f.options?.map((opt) => (
                          <option value={opt.value} disabled={opt.disabled || undefined} selected={opt.selected || undefined}>
                            {opt.label}
                          </option>
                        ))}
                      </select>
                      <svg class="campo-select-seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </div>
                  ) : f.type === 'textarea' ? (
                    <textarea
                      id={`form-field-c-${f.name}`}
                      name={f.name}
                      placeholder={f.placeholder}
                      rows={f.rows || 3}
                    />
                  ) : (
                    <input
                      id={`form-field-c-${f.name}`}
                      name={f.name}
                      type={f.type}
                      placeholder={f.placeholder}
                      required={f.required || undefined}
                      data-datepicker={f.datepicker ? '' : undefined}
                      autocomplete={autoMap[f.name] || (f.datepicker ? 'off' : undefined)}
                      inputmode={f.type === 'tel' ? 'tel' : f.type === 'number' ? 'numeric' : undefined}
                    />
                  )}
                </div>
              ))}
              <div class="acao">
                <button class="btn btn-brasa" type="button">Solicitar Orçamento</button>
              </div>
            </div>
          </form>
          <div id="form-contato-success" class="form-success">
            <div class="form-success-icon">✓</div>
            <h3>Orçamento enviado!</h3>
            <p>Nossa equipe entrará em contato em breve.</p>
          </div>
          <p class="aviso-privacidade">Suas informações são utilizadas somente para retorno de orçamento e nunca são compartilhadas.</p>
        </div>
      </div>
    </section>

  </main>

