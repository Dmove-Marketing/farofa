}

/* ── Animações de rolagem ──────────────────────────────────── */
.js-animar [data-revelar] { opacity: 0; transform: translate3d(0, 34px, 0); transition: opacity .9s ease, transform 1s cubic-bezier(.2, .7, .2, 1); transition-delay: var(--atraso, 0ms); }
