---
import 'flatpickr/dist/flatpickr.min.css';
import Base from '../layouts/Base.astro';
import { getPreset } from '../scripts/form-presets';
import config from '../../config.json';

const fields   = getPreset(config.forms['lead-form'].preset);
const webhook  = config.forms['lead-form'].webhooks[0];
const cdn      = config.media.cdn_base + '/photos';
const photo    = (name: string) => `${cdn}/${name}.webp`;
const waPhone  = config.whatsapp.phone;

const title       = 'Eventos corporativos no Farofa | Vila Leopoldina, São Paulo';
const description = 'Espaço para eventos corporativos na Vila Leopoldina (SP): até 250 pessoas, 1.200 m², ambientes interno e externo, churrasqueira de 40 metros e cozinha própria. Solicite orçamento.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type':    'EventVenue',
  name:        'Farofa — Brasa & Prosa',
  description,
  address: {
    '@type':          'PostalAddress',
    streetAddress:    'R. Guaipá, 551',
    addressLocality:  'São Paulo',
    addressRegion:    'SP',
    postalCode:       '05089-001',
    addressCountry:   'BR',
  },
  telephone: `+${waPhone}`,
};

// autocomplete por campo
const autoMap: Record<string, string> = {
  nome: 'name', email: 'email', telefone: 'tel', empresa: 'organization',
};
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  theme="dark"
  whatsAppShowEmpresaField={true}
>
  <Fragment slot="head">
    <script is:inline>
      if ('IntersectionObserver' in window &&
          !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) {
        document.documentElement.classList.add('js-animar');
      }
    </script>
    <link rel="preload" href="/fonts/tan-harmoni.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Quicksand:wght@400;500;600;700&display=swap" />
  </Fragment>

  <!-- ícones reutilizáveis (sprite inline) -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="i-whatsapp" viewBox="0 0 24 24"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.27-.2-.57-.34m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41z"/></symbol>
      <symbol id="i-pessoas" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7.5" r="2.6"/><path d="M7.5 19.5V18a4.5 4.5 0 0 1 9 0v1.5"/><circle cx="5.5" cy="10" r="2"/><path d="M2 19.5v-1a3.5 3.5 0 0 1 4.6-3.3"/><circle cx="18.5" cy="10" r="2"/><path d="M22 19.5v-1a3.5 3.5 0 0 0-4.6-3.3"/></symbol>
    </defs>
  </svg>

  <!-- CABEÇALHO -->
  <header class="cabecalho" id="cabecalho">
    <div class="wrap">
      <a class="logo" href="#topo" aria-label="Farofa, brasa e prosa — início">
        <img src={`${cdn}/logo-farofa-creme.svg`} alt="Farofa — brasa &amp; prosa" width="894" height="290" />
      </a>
      <div class="cabecalho-acoes">
        <a class="btn btn-brasa" href="#contato">Solicite orçamento</a>
      </div>
    </div>
  </header>

  <main>

    <!-- PRIMEIRA DOBRA: HERO + FORMULÁRIO -->
    <div class="primeira-dobra">
      <div class="wrap hero-grade">
        <section class="hero" id="topo">
          <div class="hero-fundo">
            <img src={photo('hero-galpao-farofa')} alt="Galpão do Farofa com mesas de madeira, telões e bar ao fundo" width="1920" height="1280" fetchpriority="high" />
          </div>
          <div class="hero-texto">
            <p class="local">Vila Leopoldina • São Paulo</p>
            <h1>Eventos corporativos fora do óbvio</h1>
            <p class="hero-sub">Um espaço para reunir o time com brasa, prosa e menos formalidade</p>
          </div>
        </section>

        <section class="form-topo" id="orcamento" aria-label="Solicite orçamento">
          <div class="form-cartao">
            <form
              class="form-orcamento"
              data-form-id="lead-form-topo"
              data-submit-url={webhook}
              data-grid-id="form-topo-campos"
              data-success-id="form-topo-success"
            >
              <input name="website" type="text" style="display:none" tabindex="-1" autocomplete="off" />
              <div class="campos" id="form-topo-campos">
                {fields.map((f) => (
                  <div class:list={['campo', f.full ? 'campo-full' : '']}>
                    <label for={`form-field-${f.name}`}>
                      {f.label}{f.hint && <> <span class="campo-hint">({f.hint})</span></>}
                    </label>
                    {f.type === 'select' ? (
                      <div class="campo-select-wrap">
                        <select
                          id={`form-field-${f.name}`}
                          name={f.name}
                          required={f.required || undefined}
                        >
                          {f.options?.map((opt) => (
                            <option value={opt.value} disabled={opt.disabled || undefined} selected={opt.selected || undefined}>
                              {opt.label}
                            </option>
                          ))}
                        </select>
                        <svg class="campo-select-seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                      </div>
                    ) : f.type === 'textarea' ? (
                      <textarea
                        id={`form-field-${f.name}`}
                        name={f.name}
                        placeholder={f.placeholder}
                        rows={f.rows || 3}
                      />
                    ) : (
                      <input
                        id={`form-field-${f.name}`}
                        name={f.name}
                        type={f.type}
                        placeholder={f.placeholder}
                        required={f.required || undefined}
                        data-datepicker={f.datepicker ? '' : undefined}
                        autocomplete={autoMap[f.name] || (f.datepicker ? 'off' : undefined)}
                        inputmode={f.type === 'tel' ? 'tel' : f.type === 'number' ? 'numeric' : undefined}
                      />
                    )}
                  </div>
                ))}
                <div class="acao">
                  <button class="btn btn-brasa" type="button">Solicitar Orçamento</button>
                </div>
              </div>
            </form>
            <div id="form-topo-success" class="form-success">
              <div class="form-success-icon">✓</div>
              <h3>Orçamento enviado!</h3>
              <p>Nossa equipe entrará em contato em breve.</p>
            </div>
            <p class="aviso-privacidade">Suas informações são utilizadas somente para retorno de orçamento e nunca são compartilhadas.</p>
          </div>
        </section>
      </div>
    </div>

    <!-- AUTORIDADE -->
    <section class="autoridade" id="autoridade" aria-label="O espaço em números">
      <div class="wrap">
        <ul>
          <li>
            <svg aria-hidden="true"><use href="#i-pessoas"/></svg>
            <strong>Até <span class="contador" data-alvo="250">250</span> pessoas</strong>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8V3h5M16 3h5v5M21 16v5h-5M8 21H3v-5"/><path d="M8 8h8v8H8z" opacity=".55"/></svg>
            <strong><span class="contador" data-alvo="1200">1.200</span> <span class="unidade">m²</span></strong>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12 9 6.5l6.5 5.5M4.5 10.3V20h9v-9.7M7.5 20v-4h3v4"/><circle cx="19" cy="6" r="2.2"/><path d="M19 1.6v.9M19 9.5v.9M14.6 6h.9M22.5 6h.9M15.9 2.9l.6.6M21.5 8.5l.6.6M22.1 2.9l-.6.6M16.5 8.5l-.6.6"/></svg>
            <strong>Ambientes interno e externo</strong>
          </li>
        </ul>
      </div>
    </section>

    <!-- EXPERIÊNCIA 360° -->
    <section class="secao experiencia" id="experiencia">
      <div class="wrap experiencia-grade">
        <div class="experiencia-texto">
          <h2 class="titulo-secao"><span>Mais espaço para</span> <span>o encontro.</span> <span>Menos cara de</span> <span>evento corporativo</span></h2>
          <p class="texto-secao">O Farofa combina ambientes internos e externos, gastronomia, música e uma atmosfera descontraída para tirar o time do automático e transformar o evento em uma experiência mais leve.</p>
        </div>
        <div class="experiencia-foto">
          <img src={photo('experiencia-360-area-externa-noite')} alt="Área externa do Farofa à noite, cheia de convidados sob o varal de luzes e os guarda-sóis" width="1920" height="1280" loading="lazy" decoding="async" />
          <div class="selo-360" aria-hidden="true">
            <svg class="anel" viewBox="0 0 200 200">
              <defs><path id="circulo-selo" d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0"/></defs>
              <text font-family="Architects Daughter, cursive" font-size="17" fill="currentColor" letter-spacing="1">
                <textPath href="#circulo-selo" textLength="470" lengthAdjust="spacing">ambientes • gastronomia • música • prosa •</textPath>
              </text>
            </svg>
            <span class="numero">360°</span>
          </div>
        </div>
      </div>
    </section>

    <!-- TIPOS DE EVENTOS -->
    <section class="secao eventos" id="eventos">
      <div class="wrap">
        <h2 class="titulo-secao"><span>Para cada encontro, um jeito</span> <span>diferente de fazer acontecer</span></h2>
        <ul class="lista-eventos">
          <li>
            <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h6l-.5 12h-5z" transform="rotate(15 6 20)"/><path d="M3.3 13h5.4" transform="rotate(15 6 20)"/><path d="M15 8h6l-.5 12h-5z" transform="rotate(-15 18 20)"/><path d="M15.3 13h5.4" transform="rotate(-15 18 20)"/><path d="M12 2v2.2M9.2 3l.9 1.6M14.8 3l-.9 1.6"/></svg></span>
            Confraternizações
          </li>
          <li>
            <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8.5h10V19a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="M15 11h2.5a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H15"/><path d="M4.6 8.5a2.3 2.3 0 0 1 1.6-3.9 3 3 0 0 1 5.4-1.2 2.6 2.6 0 0 1 4.1 2.6 1.6 1.6 0 0 1-.3 2.5"/><path d="M8.5 12v6M11.5 12v6"/></svg></span>
            Happy hours
          </li>
          <li>
            <span class="icone-evento"><svg aria-hidden="true"><use href="#i-pessoas"/></svg></span>
            Integrações e dinâmicas
          </li>
          <li>
            <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4.5A1.5 1.5 0 0 1 4.5 3h15A1.5 1.5 0 0 1 21 4.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 13.5z"/><path d="M12 15v3M8.5 21.5 12 18l3.5 3.5"/><path d="m6.5 11.5 3-3 2.5 2 4.5-4.5"/></svg></span>
            Treinamentos e workshops
          </li>
          <li>
            <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 3h9A1.5 1.5 0 0 1 15 4.5v5a1.5 1.5 0 0 1-1.5 1.5H8l-3 2.5V11h-.5A1.5 1.5 0 0 1 3 9.5v-5A1.5 1.5 0 0 1 4.5 3z"/><path d="M10.5 12.5h9A1.5 1.5 0 0 1 21 14v4a1.5 1.5 0 0 1-1.5 1.5H19V22l-2.8-2.5h-5.7A1.5 1.5 0 0 1 9 18v-4a1.5 1.5 0 0 1 1.5-1.5z"/><path d="M6.5 7h.01M9 7h.01M11.5 7h.01"/></svg></span>
            Networking
          </li>
          <li>
            <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="3.2" cy="8" r="1.2"/><path d="M4.4 8H22"/><rect x="6.5" y="5.5" width="3" height="5" rx="1"/><rect x="11" y="5.5" width="3" height="5" rx="1"/><rect x="15.5" y="5.5" width="3" height="5" rx="1"/><path d="M12 22c-2.8 0-4.5-1.8-4.5-4 0-2.4 2-3.7 2.5-6 1.2 1 1.8 2.2 1.8 3.4.8-.5 1.3-1.4 1.4-2.4 1.8 1.4 3.3 3 3.3 5 0 2.2-1.7 4-4.5 4z"/></svg></span>
            Almoços e churrascos corporativos
          </li>
        </ul>
      </div>
    </section>

    <!-- DIFERENCIAIS -->
    <section class="secao diferenciais" id="diferenciais">
      <div class="wrap">
        <h2 class="titulo-secao"><span>Um ambiente pensado para</span> <span>experiências fora do convencional</span></h2>
        <ul class="lista-diferenciais">
          <li>
            <div class="diferencial-foto"><img src={photo('diferencial-area-externa')} alt="Área externa do Farofa ao ar livre, com mesas de madeira e guarda-sóis" width="720" height="1280" loading="lazy" decoding="async" style="object-position: 50% 62%" /></div>
            <h3>Área externa</h3>
            <p>Espaço ao ar livre para mudar o ritmo do evento e aproveitar outro ambiente.</p>
          </li>
          <li>
            <div class="diferencial-foto"><img src={photo('pexels-gorkemography-1013671176-38312285')} alt="Ambiente descontraído no Farofa, espaço kids e pet friendly" width="1050" height="1400" loading="lazy" decoding="async" /></div>
            <h3>Espaço kids / pet</h3>
            <p>Um espaço que acolhe diferentes públicos, com área kids e ambiente pet friendly.</p>
          </li>
          <li>
            <div class="diferencial-foto"><img src={photo('diferencial-estrutura-completa')} alt="Salão interno do Farofa com mesas, bar e TVs" width="1400" height="933" loading="lazy" decoding="async" /></div>
            <h3>Estrutura completa</h3>
            <p>Churrasqueira de 40 metros, mesas e cadeiras para até 200 pessoas, projetor, telão e TVs.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- GASTRONOMIA -->
    <section class="secao gastronomia" id="gastronomia">
      <div class="wrap gastronomia-topo">
        <h2 class="titulo-secao">Gastronomia no centro da experiência</h2>
        <div>
          <p class="texto-secao">Com cozinha própria e uma churrasqueira, o Farofa leva para os eventos um menu feito para compartilhar. Do café da manhã ao churrasco, do almoço ao happy hour, o formato acompanha a proposta do encontro.</p>
        </div>
      </div>
      <div class="trilho-wrap">
        <div class="trilho" id="trilho-gastronomia" tabindex="0" aria-label="Fotos da gastronomia do Farofa">
          <div class="trilho-faixa">
            <figure><img src={photo('gastronomia-costela-fogo-de-chao')} alt="Costela assando no fogo de chão" width="675" height="1200" loading="lazy" decoding="async" /></figure>
            <figure><img src={photo('gastronomia-espetinhos')} alt="Espetinhos de carne, frango e linguiça servidos na tábua" width="800" height="1200" loading="lazy" decoding="async" /></figure>
            <figure><img src={photo('gastronomia-prato-brasileiro')} alt="Prato brasileiro com arroz, feijão, couve, farofa e carne" width="1179" height="695" loading="lazy" decoding="async" /></figure>
            <figure><img src={photo('gastronomia-cafe-da-manha')} alt="Mesa de café da manhã com pães, frios e frutas" width="900" height="1200" loading="lazy" decoding="async" /></figure>
            <figure><img src={photo('gastronomia-hamburguer')} alt="Hambúrguer artesanal com queijo e salada" width="800" height="1200" loading="lazy" decoding="async" /></figure>
            <figure><img src={photo('gastronomia-bolinhos')} alt="Porção de bolinhos servida na tábua de madeira" width="900" height="1200" loading="lazy" decoding="async" /></figure>
            <figure><img src={photo('gastronomia-arroz-com-queijo-coalho')} alt="Arroz com queijo coalho grelhado em cumbuca" width="900" height="1200" loading="lazy" decoding="async" /></figure>
            <figure><img src={photo('gastronomia-mesa-de-doces')} alt="Mesa de sobremesas com bolos e banana caramelizada" width="900" height="1200" loading="lazy" decoding="async" /></figure>
          </div>
        </div>
      </div>
    </section>

    <!-- CLIENTES -->
    <section class="secao clientes" id="clientes">
      <div class="wrap clientes-grade">
        <div class="clientes-texto">
          <h2 class="titulo-secao">Empresas que já escolheram o Farofa</h2>
          <p class="texto-secao">Um espaço que já faz parte da história de diferentes empresas e recebe encontros que vão muito além do formato tradicional.</p>
        </div>
        <div class="logos-carrossel">
          <div class="logos-slider" id="logos-slider" tabindex="0" aria-label="Logos de empresas clientes. Arraste para ver mais">
            <ul class="logos">
              <li><img class="logo-natura"    src={photo('cliente-natura')}    alt="Natura"    width="289" height="220" loading="lazy" draggable="false" /></li>
              <li><img class="logo-nuvemshop" src={photo('cliente-nuvemshop')} alt="Nuvemshop" width="338" height="220" loading="lazy" draggable="false" /></li>
              <li><img class="logo-adp"       src={photo('cliente-adp')}       alt="ADP"       width="484" height="220" loading="lazy" draggable="false" /></li>
              <li><img class="logo-siemens"   src={photo('cliente-siemens')}   alt="Siemens"   width="1366" height="220" loading="lazy" draggable="false" /></li>
              <li><img class="logo-quata"     src={photo('cliente-quata')}     alt="Quatá"     width="493" height="220" loading="lazy" draggable="false" /></li>
              <li><img class="logo-swift"     src={photo('cliente-swift')}     alt="Swift"     width="366" height="220" loading="lazy" draggable="false" /></li>
            </ul>
          </div>
          <div class="logos-controles">
            <button class="seta" type="button" data-logos="anterior" aria-label="Logos anteriores"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
            <button class="seta" type="button" data-logos="proximo"  aria-label="Próximos logos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
          </div>
        </div>
      </div>
    </section>

    <!-- GALERIA -->
    <section class="secao galeria" id="galeria">
      <div class="wrap">
        <h2 class="titulo-secao">Eventos que saem do comum</h2>
        <div class="galeria-grade" id="galeria-grade">
          <button class="galeria-item grande" type="button"><img src={photo('galeria-01-festa-no-patio')}           alt="Festa no pátio do Farofa com convidados e bandeirinhas"         width="1400" height="933"  loading="lazy" decoding="async" /></button>
          <button class="galeria-item alto"   type="button"><img src={photo('galeria-06-roda-de-samba')}            alt="Roda de samba na área externa do Farofa"                        width="787"  height="1400" loading="lazy" decoding="async" style="object-position: 50% 68%" /></button>
          <button class="galeria-item"        type="button"><img src={photo('galeria-03-ativacao-de-marca')}        alt="Ativação de marca com carrinho de bebidas"                      width="1050" height="1400" loading="lazy" decoding="async" /></button>
          <button class="galeria-item"        type="button"><img src={photo('galeria-04-dj-na-area-externa')}       alt="DJ tocando para os convidados na área externa ao entardecer"    width="1050" height="1400" loading="lazy" decoding="async" /></button>
          <button class="galeria-item"        type="button"><img src={photo('galeria-05-atividade-ao-ar-livre')}    alt="Tapetes de treino montados no pátio para atividade ao ar livre" width="1050" height="1400" loading="lazy" decoding="async" /></button>
          <button class="galeria-item alto"   type="button"><img src={photo('galeria-08-happy-hour')}              alt="Happy hour com mesas cheias na área coberta"                    width="787"  height="1400" loading="lazy" decoding="async" style="object-position: 50% 62%" /></button>
