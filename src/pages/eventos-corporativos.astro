  }
  .hero-fundo::after { background: linear-gradient(180deg, rgba(0,0,0,.72) 0%, rgba(0,0,0,.6) 45%, rgba(0,0,0,.82) 100%); }
  .hero-fundo img { object-position: 38% 50%; }
  .form-topo { margin-inline: calc(-1 * var(--gutter)); padding: 48px var(--gutter) 56px; background: var(--cor-creme); color: var(--cor-preto); }
  .form-topo .form-cartao { background: none; box-shadow: none; padding: 0; border-radius: 0; max-width: none; }
  .form-topo .form-titulo { font-size: 40px; margin-bottom: 24px; }
  .form-orcamento .campos { grid-template-columns: minmax(0, 1fr); gap: 12px; }
